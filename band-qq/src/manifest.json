{
  "package": "io.github.gsjsjzhznsz.bandqq",
  "name": "QQ助手",
  "icon": "/common/icon.png",
  "minAPILevel": 1,
  "deviceTypeList": [
    "watch"
  ],
  "config": {
    "designWidth": 336,
    "logLevel": "log"
  },
  "features": [
    {
      "name": "system.interconnect"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.router"
    },
    {
      "name": "system.app"
    },
    {
      "name": "system.device"
    },
    {
      "name": "system.vibrator"
    },
    {
      "name": "system.prompt"
    },
    {
      "name": "system.clipboard"
    },
    {
      "name": "system.file"
    }
  ],
  "display": {
    "backgroundColor": "#000000"
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index",
        "path": "/index"
      },
      "pages/chat": {
        "component": "chat",
        "path": "/chat"
      },
      "pages/settings": {
        "component": "settings",
        "path": "/settings"
      },
      "pages/compose": {
        "component": "compose",
        "path": "/compose"
      },
      "pages/about": {
        "component": "about",
        "path": "/about"
      }
    }
  },
  "versionName": "2.11.7-pro",
  "versionCode": 102
}

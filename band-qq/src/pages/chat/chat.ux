<template>
  <div class="page {{dc === 'round' ? 'page-round' : ''}} {{dc === 'wide' ? 'page-wide' : ''}}">
    <div class="top-row">
      <image class="btn-back" src="../../common/ui/back.png" onclick="goBack"></image>
    </div>
    <div class="title-bar">
      <text class="page-title">{{name}}</text>
    </div>
    <div class="send-status" show="{{sendStatus}}">
      <text class="send-status-text">{{sendStatus}}</text>
    </div>
    <scroll id="msgList" class="msg-area" scroll-y="true" scroll-top="{{scrollTop}}">
      <div class="older-wrap" show="{{hasMore}}">
        <text class="older-btn" onclick="loadOlder">{{loadingOlder ? '加载中…' : '加载更早的消息'}}</text>
      </div>
      <div class="msg-item {{item.is_self ? 'self' : 'other'}}" for="{{item in messages}}" tid="tid">
        <!-- v2.9.0 拍一拍消息：居中特效胶囊（紫金边框 + 晃动动画，无 emoji 依赖防 tofu） -->
        <div class="poke-wrap" if="{{item.poke && !item.is_self && !item.rc}}">
          <text class="poke-bubble">{{item.content}}</text>
        </div>
        <div class="msg-col {{item.is_self ? 'col-self' : 'col-other'}}" if="{{!(item.poke && !item.is_self && !item.rc)}}">
          <text class="msg-name" if="{{item.message_type === 'group' && !item.is_self}}">{{item.sender_name}}</text>
          <text class="at-badge" if="{{item.at && !item.is_self && !item.rc}}">@我</text>
          <text class="bubble {{item.is_self ? 'bubble-self' : (item.rc ? 'bubble-rc' : (item.at ? 'bubble-other bubble-at' : 'bubble-other'))}}">{{item.content}}</text>
        </div>
      </div>
    </scroll>
    <scroll class="quick-area" scroll-x="true" show="{{quickReplies.length}}">
      <div class="quick-row">
        <div class="quick-btn" for="{{q in quickReplies}}" tid="content" @click="quickSend(q)">
          <text class="quick-text">{{q.label}}</text>
        </div>
      </div>
    </scroll>
    <div class="input-bar" @click="openCompose">
      <image class="btn" src="../../common/ui/kb_show.png"></image>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #000000; }
  .top-row { height: 78px; flex-direction: row; align-items: flex-start; justify-content: center; padding-top: 6px; }
  .btn { width: 102px; height: 72px; }
  .btn-back { width: 102px; height: 72px; }
  .title-bar { height: 30px; flex-direction: row; align-items: center; justify-content: center; }
  .send-status { height: 22px; flex-direction: row; align-items: center; justify-content: center; }
  .send-status-text { font-size: 15px; color: #0d84ff; }
  .page-title { font-size: 22px; color: #ffffff; max-width: 170px; lines: 1; text-overflow: ellipsis; }
  /* v2.5.0 Band 11 适配：消息区弹性伸展（212×520 与 192×490 双屏通吃） */
  .msg-area { flex: 1; flex-direction: column; }
  .older-wrap { height: 34px; flex-direction: row; justify-content: center; align-items: center; }
  .older-btn { font-size: 15px; color: #0d84ff; padding: 4px 12px; }
  .msg-item { width: 192px; padding: 0 8px; margin-top: 8px; flex-direction: row; flex-shrink: 0; }
  .self { justify-content: flex-end; }
  .other { justify-content: flex-start; }
  .msg-col { flex-direction: column; align-items: flex-start; flex-shrink: 0; }
  .col-self { align-items: flex-end; }
  .col-other { align-items: flex-start; }
  .msg-name { font-size: 14px; color: rgba(255, 255, 255, 0.55); margin-bottom: 4px; }
  .bubble { max-width: 140px; padding: 7px 9px; border-radius: 10px; font-size: 18px; line-height: 25px; word-break: break-all; }
  .bubble-self { background-color: #07c160; color: #ffffff; }
  /* 撤回消息：灰底灰字小一号（手机端已把内容替换为撤回文案，rc 标志随历史帧/撤回同步帧下发） */
  .bubble-rc { background-color: #1f1f1f; color: #8a8a8a; font-size: 15px; border: 1px solid #333333; }
  /* @我/全体 消息：金色正文 + 金色描边 + 呼吸动画 + 「@我」徽标，一眼识别（手机端检测 CQ:at，手环零计算）
     v2.7.0 动效：仅动 border-color 与描边亮度，不触发布局重排，低端手环无掉帧风险；
     v2.8.2 增强：v2.7.0 呼吸幅度（#1f1f1f↔#33290e）在小屏过于隐蔽，改大对比底色闪烁 +
     静态金色「@我」徽标（动画不支持时仍有双重视觉标识，不再依赖 keyframes 生效与否） */
  .bubble-at { color: #ffd54f; border: 1px solid rgba(255, 213, 79, 0.85); animation-name: atPulse; animation-duration: 2s; animation-iteration-count: infinite; animation-timing-function: ease-in-out; }
  /* 「@我」金色徽标：静态渲染不参与动画，呼吸弱化时仍是醒目标识 */
  .at-badge { font-size: 13px; line-height: 18px; color: #ffd54f; background-color: rgba(255, 213, 79, 0.16); border: 1px solid rgba(255, 213, 79, 0.55); border-radius: 6px; padding: 1px 6px; margin-bottom: 3px; }
  @keyframes atPulse {
    0% { border-color: rgba(255, 213, 79, 0.2); background-color: #1f1f1f; }
    50% { border-color: rgba(255, 213, 79, 1); background-color: #4a3808; }
    100% { border-color: rgba(255, 213, 79, 0.2); background-color: #1f1f1f; }
  }
  .bubble-other { background-color: #1f1f1f; color: #ffffff; }
  /* v2.9.0 拍一拍特效：居中紫色胶囊 + 有限次数晃动动画（transform 不触发布局重排）
     QQ 业务规则：私聊没有 @只有拍一拍，拍一拍是私聊唯一的强提醒通道 */
  .poke-wrap { width: 192px; flex-direction: row; justify-content: center; margin: 4px 0; }
  .poke-bubble { font-size: 16px; line-height: 22px; color: #e3b8ff; background-color: rgba(146, 79, 202, 0.22); border: 1px solid rgba(227, 184, 255, 0.65); border-radius: 14px; padding: 5px 12px; animation-name: pokeShake; animation-duration: 0.8s; animation-iteration-count: 3; animation-timing-function: ease-in-out; }
  @keyframes pokeShake {
    0% { transform: translateX(0px) rotate(0deg); background-color: rgba(146, 79, 202, 0.10); }
    25% { transform: translateX(-6px) rotate(-2deg); background-color: rgba(146, 79, 202, 0.35); }
    50% { transform: translateX(6px) rotate(2deg); background-color: rgba(146, 79, 202, 0.35); }
    75% { transform: translateX(-3px) rotate(-1deg); }
    100% { transform: translateX(0px) rotate(0deg); background-color: rgba(146, 79, 202, 0.22); }
  }
  /* 快捷回复：横向滚动按钮行，标签为手机端剥离 CQ 码后的纯文本 */
  .quick-area { height: 56px; flex-direction: row; align-items: center; }
  .quick-row { flex-direction: row; align-items: center; padding: 0 6px; height: 56px; }
  .quick-btn { height: 40px; border-radius: 20px; background-color: #262626; border-width: 1px; border-color: #3a3a3a; justify-content: center; align-items: center; margin: 0 4px; padding: 0 12px; flex-shrink: 0; }
  .quick-text { font-size: 16px; color: #e8e8e8; }
  .input-bar { height: 74px; flex-direction: row; align-items: center; justify-content: center; border-top: 1px solid #222222; }

  /* ============ v2.10.0 机型分档覆盖 ============
     宽屏/圆屏视口纵向紧张：顶栏/快捷区/输入栏紧凑化，
     发送状态改绝对定位悬浮，不占布局高度 */
  .page-wide { }
  .page-wide .top-row { height: 44px; }
  .page-wide .btn-back { width: 56px; height: 40px; }
  .page-wide .title-bar { height: 26px; }
  .page-wide .page-title { font-size: 19px; }
  .page-wide .send-status { height: 0px; overflow: hidden; }
  .page-wide .send-status-text { font-size: 12px; }
  .page-wide .msg-col { max-width: 150px; }
  .page-wide .quick-area { height: 36px; }
  .page-wide .quick-row { height: 36px; }
  .page-wide .quick-btn { height: 28px; border-radius: 14px; }
  .page-wide .quick-text { font-size: 13px; }
  .page-wide .input-bar { height: 42px; }
  .page-wide .btn { width: 56px; height: 40px; }
  .page-round { }
  .page-round .top-row { height: 38px; }
  .page-round .btn-back { width: 50px; height: 34px; }
  .page-round .title-bar { height: 22px; }
  .page-round .page-title { font-size: 17px; max-width: 150px; }
  .page-round .send-status { height: 0px; overflow: hidden; }
  .page-round .send-status-text { font-size: 12px; }
  .page-round .msg-col { max-width: 150px; }
  .page-round .quick-area { height: 28px; }
  .page-round .quick-row { height: 28px; }
  .page-round .quick-btn { height: 22px; border-radius: 11px; padding: 0 8px; }
  .page-round .quick-text { font-size: 11px; }
  .page-round .input-bar { height: 34px; border-top: none; }
  .page-round .btn { width: 50px; height: 34px; }
</style>

<script>
  import router from '@system.router'
  import protocol from '../../common/protocol'

  const HISTORY_LIMIT = 30

  export default {
    protected: {
      targetId: '',
      name: '',
      messages: []
    },
    private: {
      sendStatus: '',
      scrollTop: 0,
      quickReplies: [],
      hasMore: false,
      loadingOlder: false,
      dc: 'band'
    },
    onInit(params) {
      console.log('[BANDQQ] v21 chat onInit')
      const def0 = this.$app.$def
      this.dc = def0.deviceProfile.cls()
      def0.on('device_profile', () => { this.dc = def0.deviceProfile.cls() })
      let targetId = (params && params.targetId) || ''
      let convName = (params && params.name) || ''
      if (!targetId && params && params.uri) {
        const q = (params.uri.split('?')[1] || '')
        if (q) {
          const m = {}
          q.split('&').forEach((kv) => { const i = kv.indexOf('='); if (i > 0) m[decodeURIComponent(kv.slice(0, i))] = decodeURIComponent(kv.slice(i + 1)) })
          targetId = m.targetId || ''
          convName = m.name || ''
        }
      }
      // 系统可能对完整 uri 二次编码，名称出现 %xx 时再解一次
      try { if (convName.indexOf('%') >= 0) convName = decodeURIComponent(convName) } catch (e) {}
      if (!targetId) {
        const st = this.$app.$def.store
        const last = st.getLastTarget()
        if (last && last.targetId) {
          targetId = last.targetId
          convName = last.name || convName
        }
      }
      this.targetId = targetId
      this.name = convName || '聊天'
      const def = this.$app.$def
      this._handlers = {
        message: () => this.loadMessages(false),
        history: (msg) => {
          if (msg.target_id === this.targetId) this.onHistoryArrived(msg)
        },
        cleared: () => this.loadMessages(false),
        send_status: () => this.refreshSendStatus(),
        quick_replies: () => this.loadQuickReplies()
      }
      def.on('message', this._handlers.message)
      def.on('history', this._handlers.history)
      def.on('cleared', this._handlers.cleared)
      def.on('send_status', this._handlers.send_status)
      def.on('quick_replies', this._handlers.quick_replies)
      this.loadQuickReplies()
      this.requestHistory(0)
      this.loadMessages(true)
      this.refreshSendStatus()
    },
    onShow() {
      this.loadMessages(false)
      // 打开聊天即上报已读，手机端清零未读并回推会话列表
      this.reportRead()
    },
    onDestroy() {
      const def = this.$app.$def
      if (this._handlers) {
        def.off('message', this._handlers.message)
        def.off('history', this._handlers.history)
        def.off('cleared', this._handlers.cleared)
        def.off('send_status', this._handlers.send_status)
        def.off('quick_replies', this._handlers.quick_replies)
        this._handlers = null
      }
    },
    loadQuickReplies() {
      const store = this.$app.$def.store
      this.quickReplies = store.getQuickReplies()
    },
    /** 快捷回复：直接发送手机端下发的 content（CQ 码原文，手机端只负责按钮标签净化） */
    quickSend(q) {
      if (!q || !q.content || !this.targetId) return
      const store = this.$app.$def.store
      // 群会话用 group 类型发送
      store.getConversations().then((convs) => {
        const conv = convs.find((c) => c.id === this.targetId)
        const mType = (conv && conv.type === 'group') ? 'group' : 'private'
        store.setSendStatus('发送中…')
        this.sendStatus = '发送中…'
        this.$app.$def.sendUpstream(protocol.sendMessage(mType, this.targetId, q.content)).then(() => {
          store.setSendStatus('已发送')
          this.sendStatus = '已发送'
          setTimeout(() => { this.sendStatus = ''; store.setSendStatus('') }, 1500)
        }, () => {
          store.setSendStatus('发送失败')
          this.sendStatus = '发送失败'
          setTimeout(() => { this.sendStatus = ''; store.setSendStatus('') }, 2500)
        })
      })
    },
    reportRead() {
      if (!this.targetId) return
      const api = this.$app.$def.api
      api.send(protocol.readChat(this.targetId)).catch(() => {})
    },
    refreshSendStatus() {
      const store = this.$app.$def.store
      const st = store.getSendStatus()
      this.sendStatus = (st && st.text) || ''
    },
    goBack() {
      router.back()
    },
    openCompose() {
      router.push({
        uri: '/compose',
        params: { targetId: this.targetId, name: this.name }
      })
    },
    /**
     * 拉取历史。before=0 拉最新一页；>0 为翻页锚点（拉取更早消息）。
     * 手机端对该组合做 1.5s 去重，这里无需额外节流。
     */
    requestHistory(before) {
      const api = this.$app.$def.api
      const payload = before > 0
        ? protocol.getHistoryOlder(this.targetId, before, HISTORY_LIMIT)
        : protocol.getHistory(this.targetId, HISTORY_LIMIT)
      api.send(payload).catch((e) => { console.error('requestHistory fail', e) })
    },
    /** history_list 到达：翻页时走合并，普通刷新走替换 */
    onHistoryArrived(msg) {
      const store = this.$app.$def.store
      const list = Array.isArray(msg.list) ? msg.list : []
      if (msg.before > 0) {
        this.loadingOlder = false
        if (list.length === 0) {
          this.hasMore = false
          return
        }
        store.prependMessages(this.targetId, list).then((added) => {
          this.hasMore = msg.has_more === true
          console.log('[chat] prepend older added=' + added + ' hasMore=' + this.hasMore)
          this.loadMessages(false, true)
        })
      } else {
        store.setMessages(this.targetId, list).then(() => {
          this.hasMore = msg.has_more === true
          this.loadMessages(true)
        })
      }
    },
    /** 翻页：以当前窗口最早消息时间为锚点 */
    loadOlder() {
      if (this.loadingOlder) return
      const anchor = this._firstRealTime
      if (!anchor) {
        this.hasMore = false
        return
      }
      this.loadingOlder = true
      this.requestHistory(anchor)
      // 超时兜底：6s 未响应解除 loading
      setTimeout(() => { this.loadingOlder = false }, 6000)
    },
    /**
     * 渲染前签名比对：列表未变化时不写 this.messages（防重渲染）。
     * 仅在新消息到达（count 增大）时滚动到底部；翻页 prepend 保持阅读位置。
     */
    async loadMessages(scrollIfNew, keepPosition) {
      const store = this.$app.$def.store
      const msgs = (await store.getMessages(this.targetId)).slice()
      // 兜底：本地明细为空但会话有摘要时展示占位（不落库，避免污染翻页锚点）
      if (msgs.length === 0) {
        const convs = await store.getConversations()
        const conv = convs.find((c) => c.id === this.targetId)
        if (conv && conv.last_msg) {
          msgs.push({
            message_type: conv.type || 'private',
            sender_name: conv.name || '会话',
            content: conv.last_msg,
            time: conv.time || Date.now(),
            is_self: false,
            _fallback: true
          })
        }
      }
      for (let i = 0; i < msgs.length; i++) {
        const m = msgs[i]
        m.tid = (m.time || 0) + '_' + i + '_' + (m.content || '').length
      }
      const last = msgs.length > 0 ? msgs[msgs.length - 1] : null
      const sig = msgs.length + '|' + (last ? (last.time || 0) + '|' + (last.content || '').length : '')
      if (sig === this._lastMsgSig && !keepPosition) {
        return
      }
      const prevCount = this._lastCount || 0
      const firstReal = msgs.find((m) => !m._fallback)
      this._firstRealTime = firstReal ? (firstReal.time || 0) : 0
      if (this._firstRealTime === 0) this.hasMore = false
      this._lastMsgSig = sig
      this._lastCount = msgs.length
      this.messages = msgs
      if (!keepPosition && msgs.length > prevCount) {
        // 新消息到达：滚动到底部（翻页 prepend 时保持阅读位置不滚动）
        this._scrollTick = (this._scrollTick || 0) + 1
        this.scrollTop = 999999 + this._scrollTick
        const el = this.$element && this.$element('msgList')
        if (el && el.scrollTo) {
          setTimeout(() => {
            try { el.scrollTo({ top: 999999, behavior: 'smooth' }) } catch (e) {}
          }, 60)
        }
      }
    }
  }
</script>

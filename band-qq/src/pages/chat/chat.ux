<template>
  <div class="page">
    <div class="top-row">
      <image class="btn-back" src="../../common/ui/back.png" onclick="goBack"></image>
    </div>
    <div class="title-bar">
      <text class="page-title">{{name}}</text>
    </div>
    <div class="send-status">
      <text class="send-status-text {{sendStatusClass}}">{{sendStatus}}</text>
    </div>
    <scroll id="msgList" class="msg-area" scroll-y="true" scroll-top="{{scrollTop}}">
      <div class="load-older" @click="loadOlder" show="{{showOlder}}">
        <!-- v1.2.0：嵌套三元会被编译器丢弃，改计算字段 -->
        <text class="load-older-text">{{olderText}}</text>
      </div>
      <block for="{{item in viewList}}" tid="item.key">
        <div class="time-tip" if="{{item.tip}}">
          <text class="time-tip-text">{{item.tip}}</text>
        </div>
        <!-- v1.2.0：Vela 5.0 编译器丢弃 mustache 三元/复合表达式，全部改预计算字段 -->
        <div class="msg-item" if="{{item.row_cls}}">
          <div class="msg-col {{item.col_cls}}">
            <text class="msg-name" if="{{item.show_name}}" style="color: {{item.name_color}}">{{item.sender_name}}</text>
            <image class="bubble-img" if="{{item.thumb}}" src="{{item.thumb}}"></image>
            <text class="bubble {{item.bubble_cls}}" if="{{item.show_bubble}}">{{item.content}}</text>
          </div>
        </div>
      </block>
    </scroll>
    <scroll class="quick-bar" scroll-x="true">
      <div class="quick-row">
        <div class="quick-chip" for="{{q in quickReplies}}" @click="sendQuick(q)">
          <text class="quick-chip-text">{{q.label}}</text>
        </div>
      </div>
    </scroll>
    <div class="input-bar" @click="openCompose">
      <image class="btn" src="../../common/ui/kb_show.png"></image>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #000000; }
  .top-row { height: 70px; flex-direction: row; align-items: flex-start; padding-top: 4px; }
  .btn { width: 102px; height: 66px; margin-left: 45px; }
  .btn-back { width: 102px; height: 66px; margin-left: 45px; }
  .title-bar { height: 32px; flex-direction: row; align-items: center; }
  .send-status { height: 24px; flex-direction: row; align-items: center; }
  .send-status-text { font-size: 16px; color: #07c160; width: 192px; text-align: center; }
  .send-fail { color: #ff4d4f; }
  .page-title { font-size: 22px; color: #ffffff; width: 192px; text-align: center; }
  .msg-area { flex: 1; flex-direction: column; }
  .load-older { width: 192px; height: 36px; align-items: center; flex-shrink: 0; }
  .load-older-text { font-size: 15px; color: #999999; width: 192px; text-align: center; }
  .time-tip { width: 192px; height: 30px; align-items: center; flex-shrink: 0; }
  .time-tip-text { font-size: 14px; color: #777777; width: 192px; text-align: center; }
  .msg-item { width: 192px; padding: 0 8px; margin-top: 8px; flex-direction: row; flex-shrink: 0; }
  .col-self { margin-left: auto; align-items: flex-end; }
  .col-other { align-items: flex-start; }
  .msg-col { flex-direction: column; align-items: flex-start; flex-shrink: 0; max-width: 150px; }
  .msg-name { font-size: 14px; color: #bbbbbb; margin-bottom: 4px; }
  .bubble { max-width: 150px; padding: 7px 10px; border-radius: 10px; font-size: 18px; line-height: 25px; word-break: break-all; }
  .bubble-self { background-color: #07c160; color: #ffffff; border-bottom-right-radius: 3px; }
  .bubble-other { background-color: #1f1f1f; color: #ffffff; border-bottom-left-radius: 3px; }
  .bubble-atme { border: 1px solid #ff9800; background-color: #553311; }
  .bubble-img { max-width: 120px; max-height: 120px; border-radius: 10px; }
  .quick-bar { height: 52px; flex-direction: row; background-color: #111111; }
  .quick-row { flex-direction: row; align-items: center; padding: 0 8px; }
  .quick-chip { height: 36px; border-radius: 18px; background-color: #262626; border-width: 1px; border-color: #333333; align-items: center; padding: 0 12px; margin-right: 8px; flex-shrink: 0; }
  .quick-chip-text { font-size: 16px; color: #0d84ff; }
  .input-bar { height: 72px; flex-direction: row; align-items: center; border-top: 1px solid #222222; }
</style>

<script>
  import router from '@system.router'
  import protocol from '../../common/protocol'

  // Stapxs 风格：群成员昵称按 ID 稳定着色
  const NAME_COLORS = ['#4fa1ff', '#35c759', '#ff9f43', '#b07cff', '#ff6b81', '#2dd4bf', '#fbbf24', '#818cf8']

  // 快捷回复（v1.2.0：全部纯文字。Vela 手环无 emoji 字体，
  // 👍❤️😂 这类字符会渲染成乱码方块，被用户反馈为「一堆格式代码」）
  const QUICK_REPLIES = [
    { label: '收到', text: '收到' },
    { label: '好的', text: '好的' },
    { label: '稍等', text: '稍等' },
    { label: '哈哈', text: '哈哈哈' },
    { label: 'OK', text: 'OK' },
    { label: '晚安', text: '晚安' },
    { label: '赞', text: '赞' },
    { label: '比心', text: '比心' },
    { label: '笑死', text: '笑死' }
  ]

  export default {
    protected: {
      targetId: '',
      name: '',
      convType: 'private',
      messages: []
    },
    private: {
      sendStatus: '',
      sendStatusClass: '',
      scrollTop: 0,
      viewList: [],
      quickReplies: QUICK_REPLIES,
      loadingOlder: false,
      olderEnd: false,
      olderText: '↑ 更早消息',
      showOlder: true
    },
    onInit(params) {
      let targetId = (params && params.targetId) || ''
      let convName = (params && params.name) || ''
      let convType = (params && params.type) || ''
      if (!targetId && params && params.uri) {
        const q = (params.uri.split('?')[1] || '')
        if (q) {
          const m = {}
          q.split('&').forEach((kv) => { const i = kv.indexOf('='); if (i > 0) m[decodeURIComponent(kv.slice(0, i))] = decodeURIComponent(kv.slice(i + 1)) })
          targetId = m.targetId || ''
          convName = m.name || ''
          convType = m.type || convType
        }
      }
      try { if (convName.indexOf('%') >= 0) convName = decodeURIComponent(convName) } catch (e) {}
      if (!targetId) {
        const st = this.$app.$def.store
        const last = st.getLastTarget()
        if (last && last.targetId) {
          targetId = last.targetId
          convName = last.name || convName
          convType = last.type || convType
        }
      }
      const appDef = this.$app.$def
      if (!convType) {
        appDef.store.getConversations().then((convs) => {
          const c = convs.find((x) => x.id === targetId)
          if (c && c.type) this.convType = c.type
        })
      }
      this.targetId = targetId
      this.name = convName || '聊天'
      this.convType = convType === 'group' ? 'group' : (convType || 'private')
      // 查看中：新消息不计未读；进入即清未读与 [@我] 标记
      appDef.store.setActiveChat(this.targetId)
      const def = this.$app.$def
      this._handlers = {
        message: () => this.loadMessages(),
        history: (msg) => {
          if (msg.target_id !== this.targetId) return
          if (msg.mode === 'older') {
            // 翻页结果：合并后保持位置，不滚到底
            this.loadingOlder = false
            if (this._olderTimer) { clearTimeout(this._olderTimer); this._olderTimer = null }
            if (msg.has_more === false) this.olderEnd = true
            this.loadMessages(true)
          } else {
            this.olderEnd = false
            this.loadMessages()
          }
          // v1.2.0：翻页按钮文案与显隐（计算字段，避开模板表达式）
          this.olderText = this.loadingOlder ? '加载中' : '↑ 更早消息'
          this.showOlder = !this.olderEnd || this.loadingOlder
        },
        cleared: () => this.loadMessages(),
        send_status: () => this.refreshSendStatus()
      }
      def.on('message', this._handlers.message)
      def.on('history', this._handlers.history)
      def.on('cleared', this._handlers.cleared)
      def.on('send_status', this._handlers.send_status)
      this.requestHistory()
      this.loadMessages()
      this.refreshSendStatus()
    },
    onDestroy() {
      const def = this.$app.$def
      def.store.setActiveChat(null)
      if (this._olderTimer) { clearTimeout(this._olderTimer); this._olderTimer = null }
      if (this._handlers) {
        def.off('message', this._handlers.message)
        def.off('history', this._handlers.history)
        def.off('cleared', this._handlers.cleared)
        def.off('send_status', this._handlers.send_status)
        this._handlers = null
      }
    },
    refreshSendStatus() {
      const store = this.$app.$def.store
      const st = store.getSendStatus()
      this.sendStatus = (st && st.text) || ''
      this.sendStatusClass = this.sendStatus.indexOf('失败') >= 0 ? 'send-fail' : ''
    },
    onShow() {
      const store = this.$app.$def.store
      store.setActiveChat(this.targetId)
      store.markRead(this.targetId)
      store.clearAtMe(this.targetId)
      this.loadMessages()
    },
    goBack() {
      router.back()
    },
    openCompose() {
      router.push({
        uri: '/compose',
        params: { targetId: this.targetId, name: this.name, type: this.convType }
      })
    },
    sendQuick(q) {
      const text = (q && q.text) || ''
      if (!text || !this.targetId) return
      const store = this.$app.$def.store
      // 乐观回显：立即上屏（手机端回推同 time|content 会去重）
      const t = Date.now()
      store.upsertMessage({
        message_type: this.convType,
        target_id: this.targetId,
        target_name: this.name,
        sender_id: '',
        sender_name: '我',
        content: text,
        is_self: true,
        time: t
      })
      this.$app.$def.sendUpstream(protocol.sendMessage(this.convType, this.targetId, text)).catch(() => {})
      this.loadMessages()
    },
    requestHistory() {
      const api = this.$app.$def.api
      api.send(protocol.getHistory(this.targetId, 50))
    },
    loadOlder() {
      if (this.loadingOlder || this.olderEnd || !this.targetId) return
      const msgs = this.messages || []
      if (!msgs.length) { this.olderEnd = true; return }
      this.loadingOlder = true
      this.olderText = '加载中'
      this.showOlder = true
      const api = this.$app.$def.api
      api.send(protocol.getHistory(this.targetId, 20, { older: true, beforeTime: msgs[0].time }))
      // 超时兜底：手机端无更多或未响应时恢复按钮（history 到达时会清除本计时器）
      if (this._olderTimer) clearTimeout(this._olderTimer)
      this._olderTimer = setTimeout(() => {
        this.loadingOlder = false
        this.olderText = '↑ 更早消息'
        this.showOlder = !this.olderEnd
        this._olderTimer = null
      }, 6000)
    },
    nameColor(senderId) {
      const s = String(senderId || '')
      if (!s) return NAME_COLORS[0]
      let h = 0
      for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) % 997
      return NAME_COLORS[h % NAME_COLORS.length]
    },
    async loadMessages(keepPosition) {
      const store = this.$app.$def.store
      const msgs = (await store.getMessages(this.targetId)).slice()
      const convs = await store.getConversations()
      const conv = convs.find((c) => c.id === this.targetId)
      if (conv && conv.last_msg && !msgs.some((m) => m.content === conv.last_msg)) {
        msgs.push({
          message_type: conv.type || 'private',
          sender_name: conv.name || '会话',
          content: conv.last_msg,
          time: conv.time || Date.now(),
          is_self: false
        })
      }
      msgs.sort((a, b) => (a.time || 0) - (b.time || 0))
      this.messages = msgs
      // 构建视图列表：插入时间分隔条（≥5 分钟，Stapxs 规则）+ 昵称色 + 缩略图 + @我 标记
      // v1.2.0：全部展示字段在此预计算（key/色值），模板零函数调用 + tid 键控 diff（跳动/性能双修）
      const view = []
      let prev = 0
      for (const m of msgs) {
        if (protocol.needTimeSplit(prev, m.time)) {
          view.push({ key: 't' + m.time, tip: protocol.formatTime(m.time) })
        }
        prev = m.time
        const isSelf = m.is_self === true
        const showName = m.message_type === 'group' && !isSelf
        const thumb = m.thumb || store.getThumb(this.targetId, m.time) || ''
        let bubbleCls = isSelf ? 'bubble-self' : 'bubble-other'
        if (m.at_me === true) bubbleCls += ' bubble-atme'
        view.push({
          key: 'm' + m.time + '|' + (m.content || '').slice(0, 24),
          message_type: m.message_type,
          sender_name: m.sender_name,
          sender_id: m.sender_id,
          is_self: isSelf,
          at_me: m.at_me === true,
          content: m.content,
          time: m.time,
          row_cls: isSelf ? 'self' : 'other',
          col_cls: isSelf ? 'col-self' : 'col-other',
          bubble_cls: bubbleCls,
          show_name: showName,
          show_bubble: !thumb,
          name_color: isSelf ? 'rgba(255,255,255,0.55)' : this.nameColor(m.sender_id),
          thumb: thumb
        })
      }
      this.viewList = view
      // 新消息/首次加载滚到底部；翻页(keepPosition)保持位置
      if (!keepPosition) {
        this._scrollTick = (this._scrollTick || 0) + 1
        this.scrollTop = 999999 + this._scrollTick
        const el = this.$element && this.$element('msgList')
        if (el && el.scrollTo) {
          setTimeout(() => {
            try { el.scrollTo({ top: 999999 }) } catch (e) {}
          }, 60)
        }
      }
    }
  }
</script>

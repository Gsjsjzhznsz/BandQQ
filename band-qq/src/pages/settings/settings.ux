<template>
  <div class="page">
    <div class="top-row">
      <image class="btn" src="../../common/ui/back.png" onclick="goBack"></image>
    </div>
    <div class="title-bar">
      <text class="page-title">设置</text>
    </div>
    <scroll class="body" scroll-y="true">
      <div class="card row">
        <text class="row-label">登录账号</text>
        <text class="row-value account">{{accountText}}</text>
      </div>
      <div class="card row">
        <text class="row-label">互联状态</text>
        <text class="row-value">{{statusText}}</text>
      </div>
      <div class="card row">
        <text class="row-label">协议端</text>
        <text class="row-value">{{protocolText}}</text>
      </div>
      <div class="card row">
        <text class="row-label">输入法字库</text>
        <text class="row-value">{{dictText}}字</text>
      </div>
      <div class="card row" @click="askClear">
        <text class="row-label">清空全部聊天记录</text>
        <text class="row-value danger">清空</text>
      </div>
    </scroll>

    <div class="mask" if="{{confirmShow}}">
      <div class="confirm-box">
        <text class="confirm-title">警告</text>
        <text class="confirm-desc">将清空本手环与手机端保存的全部聊天记录，此操作不可恢复，确定继续？</text>
        <div class="confirm-btns">
          <text class="confirm-cancel" onclick="cancelClear">取消</text>
          <text class="confirm-ok" onclick="doClear">确定</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #000000; }
  .top-row { height: 78px; align-items: flex-start;  padding-top: 6px; }
  .btn { width: 102px; height: 72px; }
  .title-bar { height: 40px; align-items: center;  }
  .page-title { font-size: 24px; color: #ffffff; width: 192px; text-align: center; }
  .card { border-width: 1px; border-color: #ffffff; border-radius: 16px; background-color: #262626; }
  .row { height: 52px; flex-direction: row; align-items: center; margin: 4px 8px; padding: 0 12px; }
  .row-label { font-size: 20px; color: #ffffff; }
  .row-value { margin-left: auto; text-align: right; font-size: 20px; color: #07c160; }
  .row-value.danger { color: #ff5a5a; }
  .row-value.account { color: #0d84ff; }
  .section { font-size: 16px; color: #ffffff; padding: 8px 12px; }
  .body { height: 372px; width: 192px; flex-direction: column; }
  .mask { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #000000; align-items: center;  }
  .confirm-box { width: 176px; background-color: #2b2b2b; border-radius: 14px; padding: 14px; flex-direction: column; margin-top: 130px; }
  .confirm-title { font-size: 18px; color: #ff5a5a; font-weight: bold; text-align: center; margin-bottom: 8px; }
  .confirm-desc { font-size: 14px; color: #ffffff; text-align: center; margin-bottom: 14px; }
  .confirm-btns { flex-direction: row;  }
  .confirm-cancel { flex: 1; text-align: center; padding: 9px 0; font-size: 16px; color: #999999; background-color: #3a3a3a; border-radius: 12px; margin-right: 8px; }
  .confirm-ok { flex: 1; text-align: center; padding: 9px 0; font-size: 16px; color: #ffffff; background-color: #ff5a5a; border-radius: 12px; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import protocol from '../../common/protocol'
  import { dict } from '../../components/InputMethod/assets/dic.js'

  export default {
    private: {
      statusText: '未连接',
      protocolText: '未知',
      accountText: '获取中…',
      dictText: '',
      confirmShow: false
    },
    onShow() {
      this.refreshStatus()
      this.pullConnectState()
      this.refreshAccount()
    },
    onInit() {
      // 字库字数统计（去重）
      const chars = new Set()
      for (const k in dict) {
        for (const c of dict[k]) chars.add(c)
      }
      this.dictText = String(chars.size)
      // v1.2.0：保存 handler 引用并精确 off —— 此前 off('state') 不带 fn 会清空
      // 全部 state 监听，把 index 页的连接状态刷新回调也误删了
      this._stateHandler = () => this.refreshStatus()
      this._loginHandler = () => this.refreshAccount()
      this.$app.$def.on('state', this._stateHandler)
      this.$app.$def.on('login_info', this._loginHandler)
    },
    onDestroy() {
      if (this._stateHandler) {
        this.$app.$def.off('state', this._stateHandler)
        this._stateHandler = null
      }
      if (this._loginHandler) {
        this.$app.$def.off('login_info', this._loginHandler)
        this._loginHandler = null
      }
    },
    refreshAccount() {
      const p = this.$app.$def.store.getMyProfile()
      if (p && p.user_id) {
        this.accountText = (p.nickname || '') + ' (' + p.user_id + ')'
      } else {
        this.accountText = '连接后自动获取'
      }
    },
    goBack() {
      router.back()
    },
    async pullConnectState() {
      const api = this.$app.$def.api
      try {
        await api.send(protocol.getConnectState())
      } catch (e) {
        console.error('pull connect state failed', e)
      }
    },
    async refreshStatus() {
      const store = this.$app.$def.store
      const s = store.getConnectState()
      this.statusText = s && s.band ? '已连接' : '未连接'
      this.protocolText = s ? (s.protocol ? '在线' : '离线') : '未知'
    },
    askClear() {
      this.confirmShow = true
    },
    cancelClear() {
      this.confirmShow = false
    },
    async doClear() {
      this.confirmShow = false
      const app = this.$app.$def
      const store = app.store
      const api = app.api
      // 本地立即清空，不依赖网络发送结果
      try {
        await store.clearAllMessages()
        app.emit('cleared')
        prompt.showToast({ message: '已清空' })
      } catch (e) {
        console.error('clear local fail', e)
      }
      // 通知手机端同步清空，失败不影响本地
      try {
        api.send(protocol.clearAllHistory())
      } catch (e) {
        console.error('clear remote fail', e)
      }
    }
  }
</script>
<template>
  <div class="page">
    <div class="top-row">
      <image class="btn" src="../../common/ui/back.png" onclick="goBack"></image>
    </div>
    <div class="title-bar">
      <text class="page-title">设置</text>
    </div>
    <scroll class="body" scroll-y="true">
      <div class="card row">
        <text class="row-label">互联状态</text>
        <text class="row-value">{{statusText}}</text>
      </div>
      <div class="card row">
        <text class="row-label">协议端</text>
        <text class="row-value">{{protocolText}}</text>
      </div>
      <div class="card row" @click="askClear">
        <text class="row-label">清空记录</text>
        <text class="row-value danger">清空</text>
      </div>
    </scroll>

    <div class="mask" if="{{confirmShow}}">
      <div class="confirm-box">
        <text class="confirm-title">警告</text>
        <text class="confirm-desc">将清空手环本地记录，并请求手机端清除其保存的全部聊天记录，两端同步清空且不可恢复，确定继续？</text>
        <div class="confirm-btns">
          <text class="confirm-cancel" onclick="cancelClear">取消</text>
          <text class="confirm-ok" onclick="doClear">确定</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #000000; }
  .top-row { height: 78px; align-items: flex-start; justify-content: center; padding-top: 6px; }
  .btn { width: 102px; height: 72px; }
  .title-bar { height: 40px; align-items: center; justify-content: center; }
  .page-title { font-size: 24px; color: #ffffff; }
  .card { border-width: 1px; border-color: rgba(255, 255, 255, 0.06); border-radius: 16px; background-color: #262626; }
  .row { height: 52px; flex-direction: row; align-items: center; margin: 4px 8px; padding: 0 12px; }
  .row-label { font-size: 19px; color: #ffffff; lines: 1; flex-shrink: 0; }
  .row-value { flex: 1; text-align: right; font-size: 20px; color: #07c160; }
  .row-value.danger { color: #ff5a5a; }
  .section { font-size: 16px; color: rgba(255, 255, 255, 0.6); padding: 8px 12px; }
  /* v2.5.0 Band 11 适配：主体区弹性伸展（212×520 与 192×490 双屏通吃） */
  .body { flex: 1; width: 192px; flex-direction: column; }
  .mask { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.65); align-items: center; justify-content: center; }
  .confirm-box { width: 176px; background-color: #2b2b2b; border-radius: 14px; padding: 14px; flex-direction: column; }
  .confirm-title { font-size: 18px; color: #ff5a5a; font-weight: bold; text-align: center; margin-bottom: 8px; }
  .confirm-desc { font-size: 14px; color: #ffffff; text-align: center; margin-bottom: 14px; }
  .confirm-btns { flex-direction: row; justify-content: space-between; }
  .confirm-cancel { flex: 1; text-align: center; padding: 9px 0; font-size: 16px; color: #999999; background-color: #3a3a3a; border-radius: 12px; margin-right: 8px; }
  .confirm-ok { flex: 1; text-align: center; padding: 9px 0; font-size: 16px; color: #ffffff; background-color: #ff5a5a; border-radius: 12px; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import protocol from '../../common/protocol'

  export default {
    private: {
      statusText: '未连接',
      protocolText: '未知',
      confirmShow: false
    },
    onShow() {
      this.refreshStatus()
      this.pullConnectState()
    },
    onInit() {
      this.$app.$def.on('state', () => this.refreshStatus())
    },
    onDestroy() {
      this.$app.$def.off('state')
    },
    goBack() {
      router.back()
    },
    async pullConnectState() {
      const api = this.$app.$def.api
      try {
        await api.send(protocol.getConnectState())
      } catch (e) {
        console.error('pull connect state failed', e)
      }
    },
    async refreshStatus() {
      const store = this.$app.$def.store
      const s = store.getConnectState()
      this.statusText = s && s.band ? '已连接' : '未连接'
      this.protocolText = s ? (s.protocol ? '在线' : '离线') : '未知'
    },
    askClear() {
      this.confirmShow = true
    },
    cancelClear() {
      this.confirmShow = false
    },
    async doClear() {
      this.confirmShow = false
      const app = this.$app.$def
      const store = app.store
      const api = app.api
      // 本地立即清空，不依赖网络发送结果
      try {
        await store.clearAllMessages()
        app.emit('cleared')
        prompt.showToast({ message: '已清空' })
      } catch (e) {
        console.error('clear local fail', e)
      }
      // v2.7.0 修复「手环清了又被重新同步回去」：
      // 旧实现 api.send 未 await 且失败静默 —— 清空请求丢失后手机端仍保留全部记录，
      // 下次会话同步时全部推回手环。现在 await + 重试 3 次（间隔 1.5s），确认送达。
      const frame = protocol.clearAllHistory()
      for (let i = 0; i < 3; i++) {
        try {
          await api.send(frame)
          console.log('[BANDQQ] clear_all_history delivered, attempt ' + (i + 1))
          // 发送成功后再确认一次：拉取手机端权威会话列表，正常应为空列表
          setTimeout(() => {
            try { api.send(protocol.getConversations()) } catch (e) {}
          }, 800)
          return
        } catch (e) {
          console.error('clear remote fail, attempt ' + (i + 1), e)
          if (i < 2) await new Promise((r) => setTimeout(r, 1500))
        }
      }
      prompt.showToast({ message: '已清空本地，手机端清除失败，可重试' })
    }
  }
</script>
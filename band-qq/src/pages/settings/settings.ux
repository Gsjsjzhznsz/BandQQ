<template>
  <div class="pg">
    <!-- v2.11.6 诊断信标：门控外常显，R/W/无信标三分诊断；navStat 回传导航失败原因 -->
    <text style="position:absolute;top:2px;left:4px;color:#00ff00;font-size:13px">S{{dcReady ? 'R' : 'W'}}{{navStat ? ' ' + navStat : ''}} v2.11.6</text>
  <div class="page {{dc === 'round' ? 'page-round' : ''}} {{dc === 'wide' ? 'page-wide' : ''}}" if="{{dcReady}}">
    <div class="top-row" style="{{ds.topRow}}">
      <image class="btn" style="{{ds.btn}}" src="../../common/ui/back.png" onclick="goBack"></image>
    </div>
    <div class="title-bar" style="{{ds.titleBar}}">
      <text class="page-title" style="{{ds.pageTitle}}">设置</text>
    </div>
    <scroll class="body" style="{{ds.body}}" scroll-y="true">
      <text class="section" style="{{ds.section}}">连接</text>
      <div class="card row" style="{{ds.row}}">
        <text class="row-label" style="{{ds.rowLabel}}">互联状态</text>
        <text class="row-value" style="{{ds.rowValue}}">{{statusText}}</text>
      </div>
      <div class="card row" style="{{ds.row}}">
        <text class="row-label" style="{{ds.rowLabel}}">协议端</text>
        <text class="row-value" style="{{ds.rowValue}}">{{protocolText}}</text>
      </div>
      <text class="section" style="{{ds.section}}">偏好</text>
      <div class="card row" style="{{ds.row}}" @click="toggleVibrate">
        <text class="row-label" style="{{ds.rowLabel}}">消息震动</text>
        <text class="row-value" style="{{ds.rowValue}}">{{vibrateText}}</text>
      </div>
      <div class="card row" style="{{ds.row}}" @click="toggleEmoji">
        <text class="row-label" style="{{ds.rowLabel}}">表情渲染</text>
        <text class="row-value" style="{{ds.rowValue}}">{{emojiText}}</text>
      </div>
      <text class="section" style="{{ds.section}}">更多</text>
      <div class="card row" style="{{ds.row}}" @click="goAbout">
        <text class="row-label" style="{{ds.rowLabel}}">关于 BandQQ</text>
        <text class="row-value arrow" style="{{ds.rowValue}}">›</text>
      </div>
      <div class="card row" style="{{ds.row}}" @click="askClear">
        <text class="row-label" style="{{ds.rowLabel}}">清空记录</text>
        <text class="row-value danger" style="{{ds.rowValue}}">清空</text>
      </div>
      <div class="tail-space" style="{{ds.tailSpace}}"></div>
    </scroll>

    <div class="mask" if="{{confirmShow}}">
      <div class="confirm-box" style="{{ds.confirmBox}}">
        <text class="confirm-title" style="{{ds.confirmTitle}}">警告</text>
        <text class="confirm-desc" style="{{ds.confirmDesc}}">将清空手环本地记录，并请求手机端清除其保存的全部聊天记录，两端同步清空且不可恢复，确定继续？</text>
        <div class="confirm-btns">
          <text class="confirm-cancel" style="{{ds.confirmCancel}}" onclick="cancelClear">取消</text>
          <text class="confirm-ok" style="{{ds.confirmOk}}" onclick="doClear">确定</text>
        </div>
      </div>
    </div>
  </div>
  </div>
</template>

<style>
  .pg { width:100%;height:100%;background-color:#000000;position:relative; }
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #000000; }
  .top-row { height: 78px; align-items: flex-start; justify-content: center; padding-top: 6px; }
  .btn { width: 102px; height: 72px; }
  .title-bar { height: 40px; align-items: center; justify-content: center; }
  .page-title { font-size: 24px; color: #ffffff; }
  .card { border-width: 1px; border-color: rgba(255, 255, 255, 0.06); border-radius: 16px; background-color: #262626; }
  /* v2.8.1 设置页宽松化：行高 52→58、左右边距 8→10、行距 4→6，
     分组节标题拉开层次，避免六个设置项挤成一坨 */
  .row { height: 58px; flex-direction: row; align-items: center; margin: 6px 10px; padding: 0 14px; }
  .row-label { font-size: 19px; color: #ffffff; lines: 1; flex-shrink: 0; }
  .row-value { flex: 1; text-align: right; font-size: 20px; color: #07c160; }
  .row-value.danger { color: #ff5a5a; }
  .row-value.arrow { color: #999999; }
  .row-value.dim { color: #999999; }
  .section { font-size: 14px; color: rgba(255, 255, 255, 0.45); padding: 14px 14px 2px 14px; }
  .tail-space { height: 16px; }
  /* v2.5.0 Band 11 适配：主体区弹性伸展（212×520 与 192×490 双屏通吃） */
  .body { flex: 1; width: 192px; flex-direction: column; }
  .mask { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.65); align-items: center; justify-content: center; }
  .confirm-box { width: 176px; background-color: #2b2b2b; border-radius: 14px; padding: 14px; flex-direction: column; }
  .confirm-title { font-size: 18px; color: #ff5a5a; font-weight: bold; text-align: center; margin-bottom: 8px; }
  .confirm-desc { font-size: 14px; color: #ffffff; text-align: center; margin-bottom: 14px; }
  .confirm-btns { flex-direction: row; justify-content: space-between; }
  .confirm-cancel { flex: 1; text-align: center; padding: 9px 0; font-size: 16px; color: #999999; background-color: #3a3a3a; border-radius: 12px; margin-right: 8px; }
  .confirm-ok { flex: 1; text-align: center; padding: 9px 0; font-size: 16px; color: #ffffff; background-color: #ff5a5a; border-radius: 12px; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import protocol from '../../common/protocol'
  // v2.11.5 根治：页面直引 device 模块，data() 阶段即可拿到完整安全样式表
  import deviceProfile from '../../common/device'

  export default {
    private: {
      statusText: '未连接',
      protocolText: '未知',
      vibrateText: '开',
      emojiText: '原生',
      confirmShow: false,
      dc: 'band',
      dcReady: false,
      navStat: '',
      // v2.11.5 根治：data() 阶段即初始化为完整安全样式表（band 全空串=class 基线），
      // 杜绝 onInit 异常时 ds 空对象 → undefined 样式绑定 → Vela 整棵子树渲染失败（黑屏）
      ds: deviceProfile.stylesFor('band')
    },
    onShow() {
      this.refreshStatus()
      this.refreshSettings()
      this.pullConnectState()
    },
    onInit() {
      // v2.11.5 根治：兜底先行——注册在任何可能抛错代码之前，且兜底同时修复 ds
      setTimeout(() => {
        if (this.dcReady !== true) {
          this.dcReady = true
          try {
            const d1 = (this.$app && this.$app.$def) || {}
            if (d1.deviceProfile) {
              this.dc = d1.deviceProfile.cls() || 'band'
              const s1 = d1.deviceProfile.stylesFor(this.dc)
              if (s1) this.ds = s1
            }
          } catch (x) {}
          try { console.log('[BANDQQ] dcReady fallback fired') } catch (x) {}
        }
      }, 600)
      const def = (this.$app && this.$app.$def) || {}
      // v2.11.3 加固：profile 链路异常不阻断 onInit；600ms 兜底强制放行，绝不白屏死机
      try {
        this.dc = def.deviceProfile.cls()
        this.ds = def.deviceProfile.stylesFor(this.dc)
        if (def.deviceProfile.ready()) this.dcReady = true
        def.on('device_profile', () => { this.dc = def.deviceProfile.cls(); this.ds = def.deviceProfile.stylesFor(this.dc); this.dcReady = true })
      } catch (e) { try { console.error('[BANDQQ] profile init fail', e && e.message) } catch (x) {} }
      this.$app.$def.on('state', () => this.refreshStatus())
      // v2.8.0 双端互通：手机端改了设置 → 快照到达 → 刷新行文案
      this.$app.$def.on('settings', () => this.refreshSettings())
    },
    onReady() {
      // v2.11.7 门控释放引擎级保障：onReady 由框架在首次渲染完成后触发（非定时器，
      // 不受 Vela 系引擎 setTimeout 缺陷影响）。若 profile 链路异常致门控未放行，
      // 首帧仅渲染外层信标，此处强制放行并补齐真实档位样式——黑屏最后一条路径封死
      if (this.dcReady !== true) {
        this.dcReady = true
        try {
          const d2 = (this.$app && this.$app.$def) || {}
          if (d2.deviceProfile) {
            this.dc = d2.deviceProfile.cls() || 'band'
            const s2 = d2.deviceProfile.stylesFor(this.dc)
            if (s2) this.ds = s2
          }
        } catch (x) {}
        try { console.log('[BANDQQ] dcReady released via onReady') } catch (x) {}
      }
    },

    onDestroy() {
      this.$app.$def.off('state')
      this.$app.$def.off('settings')
    },
    goBack() {
      router.back()
    },
    /** v2.8.1 修复「关于点不进去」：manifest 里 about 页注册的 path 是 /about，
     *  旧写法 uri:'/pages/about/about' 是无效路由，router.push 静默失败无反应。
     *  对照工作正常的 /settings、/chat、/compose 统一用 path 形式 */
    goAbout() {
      // v2.11.6 导航诊断：fail/success 回调写 navStat（返回后信标可见），同步拋错写 T:
      this._nav('/about')
    },
    _nav(uri, params) {
      const opts = { uri }
      if (params) opts.params = params
      opts.fail = (e) => { this.navStat = 'F:' + ((((e && e.message) || (typeof e === 'string' ? e : '')) || '?') + '').slice(0, 24) }
      opts.success = () => { this.navStat = 'OK' }
      try { router.push(opts) } catch (e) { this.navStat = 'T:' + ((e && e.message) || '?').slice(0, 24) }
    },
    async pullConnectState() {
      const api = this.$app.$def.api
      try {
        await api.send(protocol.getConnectState())
      } catch (e) {
        console.error('pull connect state failed', e)
      }
    },
    refreshSettings() {
      const st = this.$app.$def.store.getSettings()
      this.vibrateText = st.msg_vibrate !== false ? '开' : '关'
      this.emojiText = st.emoji_native !== false ? '原生' : '占位'
    },
    /** v2.8.0 双端互通：手环改「消息震动」→ 立即回传手机端（applyBandSettings 落盘） */
    toggleVibrate() {
      const app = this.$app.$def
      const store = app.store
      const next = store.getSettings().msg_vibrate === false
      store.setSettings({ msg_vibrate: next }).then(() => this.refreshSettings())
      app.sendUpstream(protocol.updateSettings({ msg_vibrate: next })).catch(() => {})
      prompt.showToast({ message: next ? '消息震动已开启' : '消息震动已关闭' })
    },
    /** v2.8.0 双端互通：手环改「表情渲染」→ 回传手机端；原生=emoji直显，占位=[表情] */
    toggleEmoji() {
      const app = this.$app.$def
      const store = app.store
      const next = store.getSettings().emoji_native === false
      store.setSettings({ emoji_native: next }).then(() => this.refreshSettings())
      app.sendUpstream(protocol.updateSettings({ emoji_native: next })).catch(() => {})
      prompt.showToast({ message: next ? '表情原生渲染' : '表情占位显示' })
    },
    async refreshStatus() {
      const store = this.$app.$def.store
      const s = store.getConnectState()
      this.statusText = s && s.band ? '已连接' : '未连接'
      this.protocolText = s ? (s.protocol ? '在线' : '离线') : '未知'
    },
    askClear() {
      this.confirmShow = true
    },
    cancelClear() {
      this.confirmShow = false
    },
    async doClear() {
      this.confirmShow = false
      const app = this.$app.$def
      const store = app.store
      const api = app.api
      // 本地立即清空，不依赖网络发送结果
      try {
        await store.clearAllMessages()
        app.emit('cleared')
        prompt.showToast({ message: '已清空' })
      } catch (e) {
        console.error('clear local fail', e)
      }
      // v2.7.0 修复「手环清了又被重新同步回去」：
      // 旧实现 api.send 未 await 且失败静默 —— 清空请求丢失后手机端仍保留全部记录，
      // 下次会话同步时全部推回手环。现在 await + 重试 3 次（间隔 1.5s），确认送达。
      const frame = protocol.clearAllHistory()
      for (let i = 0; i < 3; i++) {
        try {
          await api.send(frame)
          console.log('[BANDQQ] clear_all_history delivered, attempt ' + (i + 1))
          // 发送成功后再确认一次：拉取手机端权威会话列表，正常应为空列表
          setTimeout(() => {
            try { api.send(protocol.getConversations()) } catch (e) {}
          }, 800)
          return
        } catch (e) {
          console.error('clear remote fail, attempt ' + (i + 1), e)
          if (i < 2) await new Promise((r) => setTimeout(r, 1500))
        }
      }
      prompt.showToast({ message: '已清空本地，手机端清除失败，可重试' })
    }
  }
</script>

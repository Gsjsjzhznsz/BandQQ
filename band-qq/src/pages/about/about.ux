<template>
  <div class="page {{dc === 'round' ? 'page-round' : ''}} {{dc === 'wide' ? 'page-wide' : ''}}">
    <div class="top-row">
      <image class="btn" src="../../common/ui/back.png" onclick="goBack"></image>
    </div>
    <div class="title-bar">
      <text class="page-title">关于</text>
    </div>
    <scroll class="body" scroll-y="true">
      <div class="hero" onclick="onVerTap">
        <image class="icon" src="../../common/icon.png"></image>
        <text class="app-name">BandQQ</text>
        <!-- v2.9.0：连点版本区 7 次开启演示模式（注入演示会话，无手机也可体验界面）；
             点击区挂在整个 hero（小 text 点击区在部分固件上不响应） -->
        <text class="ver">v2.10.0 · 快应用端</text>
        <text class="demo-hint" if="{{demoHint}}">{{demoHint}}</text>
      </div>
      <div class="card col">
        <text class="line">小米手环 QQ 客户端 + Android 同步器，通过小米互联双向同步 QQ 消息，支持回复、@提醒、拍一拍特效、会话免打扰、表情、快捷回复、记录同步与自动拉起。</text>
      </div>
      <div class="card col">
        <text class="k">作者</text>
        <text class="v">一秋</text>
      </div>
      <div class="card col">
        <text class="k">联系方式</text>
        <text class="v">QQ 2308534727</text>
      </div>
      <div class="card col" @click="copyRepo">
        <text class="k">GitHub（点击复制链接）</text>
        <text class="v">github.com/Gsjsjzhznsz/BandQQ</text>
      </div>
    </scroll>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #000000; }
  .top-row { height: 78px; align-items: flex-start; justify-content: center; padding-top: 6px; }
  .btn { width: 102px; height: 72px; }
  .title-bar { height: 40px; align-items: center; justify-content: center; }
  .page-title { font-size: 24px; color: #ffffff; }
  .body { flex: 1; width: 192px; flex-direction: column; }
  .hero { flex-direction: column; align-items: center; margin: 10px 8px 4px 8px; }
  .icon { width: 64px; height: 64px; border-radius: 16px; }
  .app-name { font-size: 22px; color: #ffffff; margin-top: 6px; font-weight: bold; }
  .ver { font-size: 13px; color: rgba(255, 255, 255, 0.55); margin-top: 2px; }
  .demo-hint { font-size: 12px; color: #ffd54f; margin-top: 4px; }
  .card { border-width: 1px; border-color: rgba(255, 255, 255, 0.06); border-radius: 16px; background-color: #262626; margin: 4px 8px; padding: 10px 12px; flex-direction: column; }
  .col { flex-direction: column; }
  .line { font-size: 14px; color: #dddddd; line-height: 20px; }
  .k { font-size: 12px; color: rgba(255, 255, 255, 0.45); }
  .v { font-size: 17px; color: #5b9bff; margin-top: 2px; }

  /* ============ v2.10.0 机型分档覆盖 ============ */
  .page-wide { }
  .page-wide .top-row { height: 44px; }
  .page-wide .btn { width: 56px; height: 40px; }
  .page-wide .title-bar { height: 30px; }
  .page-round { }
  .page-round .top-row { height: 40px; }
  .page-round .btn { width: 50px; height: 36px; }
  .page-round .title-bar { height: 22px; }
  .page-round .page-title { font-size: 19px; }
  .page-round .body { width: 100%; padding: 0 14px; }
  .page-round .hero { margin: 4px 8px 0 8px; }
  .page-round .icon { width: 44px; height: 44px; border-radius: 12px; }
  .page-round .app-name { font-size: 18px; margin-top: 4px; }
  .page-round .card { margin: 3px 2px; padding: 7px 10px; border-radius: 12px; }
  .page-round .line { font-size: 12px; line-height: 17px; }
  .page-round .v { font-size: 14px; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import clipboard from '@system.clipboard'

  const REPO_URL = 'https://github.com/Gsjsjzhznsz/BandQQ'

  export default {
    private: {
      demoHint: '',
      dc: 'band'
    },
    _tapCount: 0,
    _tapTimer: null,
    onInit() {
      const def = this.$app.$def
      this.dc = def.deviceProfile.cls()
      def.on('device_profile', () => { this.dc = def.deviceProfile.cls() })
    },
    goBack() {
      router.back()
    },
    /** v2.9.0 演示模式彩蛋：连点版本区 7 次注入演示会话（虚拟机/无互联环境体验界面用） */
    onVerTap() {
      const that = this
      this._tapCount = (this._tapCount || 0) + 1
      if (this._tapTimer) clearTimeout(this._tapTimer)
      this._tapTimer = setTimeout(() => { that._tapCount = 0; that.demoHint = '' }, 2500)
      if (this._tapCount >= 7) {
        this._tapCount = 0
        this.demoHint = '正在注入演示会话…'
        const store = this.$app.$def.store
        store.injectDemo().then(() => {
          that.demoHint = '演示会话已注入'
          setTimeout(() => { that.demoHint = '' }, 2000)
          setTimeout(() => { router.back() }, 800)
        }).catch((e) => {
          that.demoHint = '注入失败'
          console.error('injectDemo failed', e)
        })
      } else if (this._tapCount >= 3) {
        this.demoHint = '再点 ' + (7 - this._tapCount) + ' 次开启演示模式'
      }
    },
    /** v2.8.1：GitHub 行点击复制仓库链接（快应用无法打开系统浏览器，复制后到手机粘贴访问） */
    copyRepo() {
      try {
        clipboard.set({
          text: REPO_URL,
          success: () => prompt.showToast({ message: '仓库链接已复制' }),
          fail: () => prompt.showToast({ message: '复制失败：github.com/Gsjsjzhznsz/BandQQ' })
        })
      } catch (e) {
        prompt.showToast({ message: 'github.com/Gsjsjzhznsz/BandQQ' })
      }
    }
  }
</script>

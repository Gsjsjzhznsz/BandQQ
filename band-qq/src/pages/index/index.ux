<template>
  <div class="page {{dc === 'round' ? 'page-round' : ''}} {{dc === 'wide' ? 'page-wide' : ''}}" if="{{dcReady}}">
    <div class="top-row" style="{{ds.topRow}}">
      <image class="btn" style="{{ds.btn}}" src="../../common/ui/more.png" @click="goSettings"></image>
    </div>
    <!-- v2.9.1 布局根治：scroll 背景只绘内容区导致列表视觉半页断裂（Vela 引擎行为），
         背景移至外层普通 div（flex:1 撑满中区），scroll 改 absolute 铺满 wrap 不再依赖引擎 flex 实现 -->
    <div class="list-wrap">
    <scroll class="list" style="{{ds.list}}" scroll-y="true" show="{{conversations.length}}">
      <div class="item" style="{{ds.item}}" for="{{item in conversations}}" tid="id" @click="openChatItem(item)" @longpress="showMenu(item)">
        <div class="avatar" style="background-color: {{item.hueBg}}; {{ds.avatar}}">
          <text class="avatar-text" style="{{ds.avatarText}}">{{item.achar}}</text>
        </div>
        <div class="mid">
          <div class="name-row">
            <text class="item-name" style="{{ds.itemName}}">{{item.n9}}</text>
            <text class="item-at" style="{{ds.itemAt}}" if="{{item.cat}}">@我</text>
            <text class="item-tag" style="{{ds.itemTag}}" if="{{item.is_temporary}}">临时</text>
          </div>
          <text class="item-prev" style="{{ds.itemPrev}}" show="{{item.prev}}">{{item.prev}}</text>
        </div>
        <div class="right" style="{{ds.right}}">
          <text class="item-time" style="{{ds.itemTime}}" show="{{item.tstr}}">{{item.tstr}}</text>
          <!-- v2.9.0：免打扰会话未读徽标变灰（长按会话开关，双端同步，不拉起快应用） -->
          <div class="{{item.muted ? 'badge badge-muted' : 'badge'}}" style="{{ds.badge}}" show="{{item.unread > 0}}">
            <text class="badge-text" style="{{ds.badgeText}}">{{item.unread > 99 ? '99+' : item.unread}}</text>
          </div>
        </div>
      </div>
    </scroll>
    <!-- 空态移入 wrap 内 absolute 覆盖，不参与 flex 布局 -->
    <div class="empty-wrap" show="{{!conversations.length}}">
      <image class="empty-icon" style="{{ds.emptyIcon}}" src="../../common/ui/empty_icon.png"></image>
      <text class="empty-text" style="{{ds.emptyText}}">{{conversations.length === 0 ? '请在手机端添加联系人' : '暂无会话'}}</text>
    </div>
    </div>
    <!-- v2.9.0 长按会话菜单：消息免打扰开关 -->
    <div class="menu-mask" if="{{menuConv}}" @click="closeMenu"></div>
    <div class="menu" style="{{ds.menu}}" if="{{menuConv}}">
      <text class="menu-title" style="{{ds.menuTitle}}">{{menuConv.n9 || menuConv.name}}</text>
      <text class="menu-row" style="{{ds.menuRow}}" onclick="toggleMute">{{menuMuted ? '关闭消息免打扰' : '消息免打扰'}}</text>
      <text class="menu-row menu-cancel" style="{{ds.menuRow}}" onclick="closeMenu">取消</text>
    </div>
    <!-- v2.11.5：屏显版本号（零布局风险的纯文本追加），安装验证不再依赖 AstroBox 包信息 -->
    <div class="status-bar" style="{{ds.statusBar}}">
      <text class="status-text" style="{{ds.statusText}}">{{statusText}} v2.11.6{{navStat ? ' ' + navStat : ''}}</text>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #000000; }
  .top-row { height: 78px; align-items: flex-start; justify-content: center; padding-top: 6px; }
  .btn { width: 102px; height: 72px; }
  /* v2.9.1 布局根治：wrap（普通 div）flex:1 撑满中区并绘制面板背景——
     Vela scroll 的 background-color 只绘制内容区不铺视口，背景放 scroll 上必然半页断裂 */
  .list-wrap { position: relative; flex: 1; flex-direction: column; background-color: rgba(0, 122, 255, 0.08); }
  /* 列表 absolute 铺满 wrap（引擎无关的确定高度）；列表项定高 + 绝对定位角标，杜绝 flex 重排抖动 */
  .list { position: absolute; left: 0; top: 0; width: 100%; height: 100%; padding: 6px 8px 0 8px; flex-direction: column; }
  .item { height: 86px; width: 100%; flex-direction: row; align-items: center; margin-bottom: 4px; border-radius: 16px; background-color: #262626; }
  .avatar { width: 44px; height: 44px; border-radius: 22px; margin-left: 10px; margin-right: 8px; justify-content: center; align-items: center; }
  .avatar-text { font-size: 20px; color: #ffffff; }
  .mid { flex: 1; flex-direction: column; justify-content: center; }
  .name-row { flex-direction: row; align-items: center; }
  .item-name { font-size: 20px; color: #ffffff; max-width: 88px; lines: 1; text-overflow: ellipsis; }
  .item-tag { font-size: 12px; color: #ffb800; border-width: 1px; border-color: #ffb800; border-radius: 6px; padding: 0 4px; margin-left: 6px; }
  /* @我 未读提示（手机端检测 CQ:at 下发 cat 标志，读后自动消失）v2.7.0 同步呼吸动效 */
  .item-at { font-size: 12px; color: #07c160; background-color: rgba(7, 193, 96, 0.14); border-radius: 6px; padding: 1px 5px; margin-left: 6px; animation-name: atTagPulse; animation-duration: 2s; animation-iteration-count: infinite; animation-timing-function: ease-in-out; }
  @keyframes atTagPulse {
    0% { background-color: rgba(7, 193, 96, 0.10); }
    50% { background-color: rgba(7, 193, 96, 0.30); }
    100% { background-color: rgba(7, 193, 96, 0.10); }
  }
  .item-prev { font-size: 15px; color: rgba(255, 255, 255, 0.45); margin-top: 4px; max-width: 96px; lines: 1; text-overflow: ellipsis; }
  .right { width: 40px; height: 86px; flex-direction: column; align-items: flex-end; justify-content: flex-start; padding: 10px 10px 0 0; position: absolute; right: 0; top: 0; }
  .item-time { font-size: 13px; color: rgba(255, 255, 255, 0.4); }
  /* 未读角标绝对定位于右上，不参与布局流（旧版负偏移方案已废弃） */
  .badge { position: absolute; right: 6px; bottom: 12px; min-width: 24px; height: 22px; border-radius: 11px; background-color: #ff5a5a; justify-content: center; align-items: center; }
  /* v2.9.0 免打扰会话：未读徽标变灰（长按会话开启） */
  .badge-muted { background-color: #6b6b6b; }
  .badge-text { font-size: 13px; color: #ffffff; padding: 0 5px; }
  .empty-wrap { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; justify-content: center; align-items: center; }
  .empty-icon { width: 78px; height: 78px; object-fit: contain; }
  /* v2.6.0：字号 18px，10 字文案在 212×520 / 192×490 双屏均不折行 */
  .empty-text { margin-top: 12px; font-size: 18px; color: rgba(255, 255, 255, 0.5); lines: 1; }
  .status-bar { height: 60px; justify-content: center; align-items: center; }
  .status-text { font-size: 20px; color: rgba(255, 255, 255, 0.6); }
  /* v2.9.0 长按菜单：底部弹层（免打扰开关） */
  .menu-mask { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.55); }
  .menu { position: absolute; left: 0; bottom: 0; width: 100%; flex-direction: column; background-color: #1f1f1f; border-top-left-radius: 20px; border-top-right-radius: 20px; padding: 14px 12px 20px 12px; }
  .menu-title { font-size: 18px; color: rgba(255, 255, 255, 0.55); text-align: center; margin-bottom: 8px; lines: 1; text-overflow: ellipsis; }
  .menu-row { font-size: 20px; color: #e8e8e8; text-align: center; padding: 12px 0; }
  .menu-cancel { color: rgba(255, 255, 255, 0.5); border-top: 1px solid #333333; }
</style>

<script>
  import router from '@system.router'
  import protocol from '../../common/protocol'
  // v2.11.5 根治：页面直引 device 模块，data() 阶段即可拿到完整安全样式表
  import deviceProfile from '../../common/device'

  const REFRESH_DEBOUNCE_MS = 120

  export default {
    private: {
      statusText: '未连接',
      conversations: [],
      menuConv: null,
      menuMuted: false,
      dc: 'band',
      dcReady: false,
      navStat: '',
      // v2.11.5 根治：data() 阶段即初始化为完整安全样式表（band 全空串=class 基线）。
      // 此前 ds:{} 空对象——onInit 若在任何一步抛错，所有 ds.* 绑定全 undefined
      // （undefined 样式绑定 = Vela 整棵子树渲染失败 = 黑屏实锤根因）
      ds: deviceProfile.stylesFor('band')
    },
    onShow() {
      console.log('[BANDQQ] v21 index onShow')
      this.refreshStatus()
      this.pullConnectState()
      this.loadConversations()
      this.loadVisibleContacts()
    },
    /** onReady 钩子触发：onShow 阶段页面栈未完全建立，replace/push 会被引擎静默丢弃（336×480 VM 实证） */
    onReady() {
      this.vvdShotHook()
    },
    /** VVD 验收钩子（band-pro 分支专用，发布构建置 '' 跳过）：
     *  触摸通道在 336×480 VM 上失效，改代码路径导航截图（worklog 397 同款手段） */
    vvdShotHook() {
      const vs = ''
      if (!vs || this._vshotDone) return
      this._vshotDone = true
      const def = this.$app.$def
      const store = def.store
      // 注意：router 用顶层 import；钩子内 require system API 可能失败且被 catch 静默吞掉
      this.statusText = 'H1'
      store.injectDemo().then(() => {
        this.statusText = 'H2'
        this.loadConversations()
        if (vs === 'list') return
        // worklog 397②③：setTimeout 不触发 + 带 query/params 的导航静默失败 → 纯裸 uri，
        // targetId/name 由 setLastTarget 预置、chat/compose 页 getLastTarget 兜底
        store.setLastTarget && store.setLastTarget({ targetId: '20001', name: 'BandQQ 体验群' })
        this.statusText = 'H3'
        router.push({ uri: '/pages/chat' })
      }).catch((e) => {
        // 钩子错误必须屏上可见（VM 无 logcat 可观测）
        this.statusText = 'HOOKERR ' + ((e && e.message) || '').slice(0, 16)
        console.error('[VVD_SHOT]', e && e.message)
      })
    },
    onInit() {
      // v2.11.5 根治：兜底先行——注册在任何可能抛错代码之前，且兜底同时修复 ds。
      // v2.11.3 的兜底只放行 dcReady 不修 ds，onInit 若在 ds 赋值前抛错则黑屏照旧
      setTimeout(() => {
        if (this.dcReady !== true) {
          this.dcReady = true
          try {
            const d1 = (this.$app && this.$app.$def) || {}
            if (d1.deviceProfile) {
              this.dc = d1.deviceProfile.cls() || 'band'
              const s1 = d1.deviceProfile.stylesFor(this.dc)
              if (s1) this.ds = s1
            }
          } catch (x) {}
          try { console.log('[BANDQQ] dcReady fallback fired') } catch (x) {}
        }
      }, 600)
      const def = (this.$app && this.$app.$def) || {}
      // v2.10.0 机型分档：读取全局 profile，异步到达后随事件刷新
      // v2.11.3 加固：profile 链路异常不阻断 onInit
      try {
        this.dc = def.deviceProfile.cls()
        this.ds = def.deviceProfile.stylesFor(this.dc)
        if (def.deviceProfile.ready()) this.dcReady = true
        def.on('device_profile', () => { this.dc = def.deviceProfile.cls(); this.ds = def.deviceProfile.stylesFor(this.dc); this.dcReady = true })
      } catch (e) { try { console.error('[BANDQQ] profile init fail', e && e.message) } catch (x) {} }
      // 抖动根治：所有数据事件统一走 120ms 尾沿防抖 + 签名比对，
      // 消息风暴时每 120ms 至多渲染一次，内容未变不触发任何渲染
      this._scheduleRefresh = () => {
        if (this._refreshTimer) clearTimeout(this._refreshTimer)
        this._refreshTimer = setTimeout(() => {
          this._refreshTimer = null
          this.refreshConversations()
        }, REFRESH_DEBOUNCE_MS)
      }
      this._handlers = {
        conversations: () => this._scheduleRefresh(),
        visible_contacts: () => this._scheduleRefresh(),
        message: () => this._scheduleRefresh(),
        quick_replies: () => {},
        state: () => this.refreshStatus(),
        cleared: () => this._scheduleRefresh()
      }
      def.on('conversations', this._handlers.conversations)
      def.on('visible_contacts', this._handlers.visible_contacts)
      def.on('message', this._handlers.message)
      def.on('state', this._handlers.state)
      def.on('cleared', this._handlers.cleared)
    },
    onReady() {
      // v2.11.7 门控释放引擎级保障：onReady 由框架在首次渲染完成后触发（非定时器，
      // 不受 Vela 系引擎 setTimeout 缺陷影响）。若 profile 链路异常致门控未放行，
      // 首帧仅渲染外层信标，此处强制放行并补齐真实档位样式——黑屏最后一条路径封死
      if (this.dcReady !== true) {
        this.dcReady = true
        try {
          const d2 = (this.$app && this.$app.$def) || {}
          if (d2.deviceProfile) {
            this.dc = d2.deviceProfile.cls() || 'band'
            const s2 = d2.deviceProfile.stylesFor(this.dc)
            if (s2) this.ds = s2
          }
        } catch (x) {}
        try { console.log('[BANDQQ] dcReady released via onReady') } catch (x) {}
      }
    },

    onDestroy() {
      const def = this.$app.$def
      if (this._handlers) {
        def.off('conversations', this._handlers.conversations)
        def.off('visible_contacts', this._handlers.visible_contacts)
        def.off('message', this._handlers.message)
        def.off('state', this._handlers.state)
        def.off('cleared', this._handlers.cleared)
        this._handlers = null
      }
    },
    async pullConnectState() {
      const api = this.$app.$def.api
      try {
        await api.send(protocol.getConnectState())
      } catch (e) {
        console.error('pull connect state failed', e)
      }
    },
    refreshStatus() {
      const store = this.$app.$def.store
      const s = store.getConnectState()
      this.statusText = s && s.band ? '已连接' : '未连接'
    },
    async loadConversations() {
      const store = this.$app.$def.store
      const list = await store.getConversations()
      this.applyConversations(list)
      const api = this.$app.$def.api
      // 闪退加固：互联未就绪时 send reject 不能裸奔（unhandled rejection 真机杀进程）
      api.send({ type: 'get_conversations', seq: Date.now() % 100000 }).catch((e) => console.log('[index] get_conversations dropped', e && e.code))
    },
    async refreshConversations() {
      const store = this.$app.$def.store
      const list = await store.getConversations()
      this.applyConversations(list)
    },
    /**
     * 签名比对后才写 this.conversations：
     * 未变化的数组引用替换不再进入渲染管线（抖动的第一根因）
     */
    applyConversations(list) {
      const sig = protocol.convSignature(list)
      if (sig === this._lastSig) {
        console.log('[index] skip render (same signature)')
        return
      }
      this._lastSig = sig
      this.conversations = list
      console.log('[index] applyConversations ->', list.length, 'conv')
    },
    openChatItem(item) {
      if (!item) return
      if (!item.id) return
      const store = this.$app.$def.store
      store.setLastTarget({ targetId: item.id, name: item.name })
      // v2.11.6 导航诊断：fail/success 回调写 navStat（底部状态栏可见）
      this._nav('/chat?targetId=' + encodeURIComponent(item.id) + '&name=' + encodeURIComponent(item.name || ''), { targetId: item.id, name: item.name })
    },
    _nav(uri, params) {
      const opts = { uri }
      if (params) opts.params = params
      opts.fail = (e) => { this.navStat = 'F:' + ((((e && e.message) || (typeof e === 'string' ? e : '')) || '?') + '').slice(0, 24) }
      opts.success = () => { this.navStat = 'OK' }
      try { router.push(opts) } catch (e) { this.navStat = 'T:' + ((e && e.message) || '?').slice(0, 24) }
    },
    /** v2.9.0 长按会话：弹出免打扰开关菜单 */
    showMenu(item) {
      if (!item || !item.id) return
      const store = this.$app.$def.store
      this.menuConv = item
      this.menuMuted = store.isMuted(item.id)
    },
    closeMenu() {
      this.menuConv = null
    },
    /** 切换免打扰：本地立即生效 + settings_update 上报手机端（拦截快应用拉起） */
    async toggleMute() {
      const item = this.menuConv
      if (!item || !item.id) return
      const def = this.$app.$def
      const store = def.store
      try {
        const state = await store.toggleMute(item.id)
        this.menuMuted = state === 1
        def.sendUpstream({ type: 'settings_update', seq: Date.now() % 100000, mute_list: store.getSettings().mute_list || '' }).catch((e) => console.log('[index] settings_update dropped', e && e.code))
        this.closeMenu()
        this._lastSig = '' // 强制刷新列表（灰点立即生效）
        this.refreshConversations()
      } catch (e) {
        console.error('toggleMute failed', e)
        this.closeMenu()
      }
    },
    async loadVisibleContacts() {
      const api = this.$app.$def.api
      try {
        await api.send(protocol.getVisibleContacts())
      } catch (e) {
        console.error('pull visible contacts failed', e)
      }
    },
    goSettings() {
      // v2.11.6 导航诊断：同 _nav 通道
      this._nav('/settings')
    }
  }
</script>

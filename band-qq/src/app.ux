<template>
  <text class="app-root"></text>
</template>

<style>
  .app-root {
    display: none;
  }
</style>

<script>
/**
 * 应用入口，暴露全局工具对象
 */
import api from './common/api'
import protocol from './common/protocol'
import store from './common/store'
import direct from './common/direct'

const listeners = {}

function emit(event, data) {
  const set = listeners[event]
  if (set) set.forEach((fn) => { try { fn(data) } catch (e) { console.error('emit error', event, e) } })
}

function handleMessage(msg) {
  if (!msg || !msg.type) return
  try {
    console.log('[BANDQQ] v10 msg <-', msg.type, msg.target_id || msg.targetId || msg.seq || '')
  } catch (e) {}
  switch (msg.type) {
    case 'ping':
      api.send({ type: 'pong', seq: msg.seq || 0 })
      break
case 'push_message':
      // v2.5.0 新消息振动提醒：手表端核心提示通道（勿扰/群聊过滤已在手机端完成，
      // 能到手的帧都是该推的）。自己发的回显、撤回同步帧、不可见会话不振动。
      // v2.8.0：受「新消息手环震动」互通开关控制（手机端/手环端均可改，双向同步）。
      // v2.8.3 @我 双保险：at=1（数字，APP Gson 直发）/true（decodePush 形态）均强提醒
      //   —— 长震一次，与普通短震区分，即使高亮样式被固件降级也能感知被 @。
      // v2.9.0：拍一拍我（poke=1/true）与 @我 同级强提醒（长震）；
      //   免打扰会话（长按会话开启）只亮红点灰标不震动不拉起。
      {
        const atMe = (msg.at === 1 || msg.at === true) && msg.is_self !== true
        const pokeMe = (msg.poke === 1 || msg.poke === true) && msg.is_self !== true
        const important = atMe || pokeMe
        const muted = typeof store.isMuted === 'function' && msg.target_id ? store.isMuted(msg.target_id) : false
        if (msg.is_self !== true && msg.recall !== 1 && msg.recall !== true && msg.recall !== 0 && msg.visible !== false && !muted) {
          try {
            const vib = require('@system.vibrator')
            if (important && store.getSettings().msg_vibrate !== false) {
              vib.vibrate({ mode: 'long' })
            } else if (store.getSettings().msg_vibrate !== false) {
              vib.vibrate({ mode: 'short' })
            }
          } catch (e) {}
        }
        if (important) { try { console.log('[BANDQQ] v19 important frame target=' + msg.target_id + ' at=' + atMe + ' poke=' + pokeMe + ' muted=' + muted) } catch (e) {} }
      }
      store.upsertMessage(msg).then(() => { try { console.log('[BANDQQ] v17 upsert target=' + msg.target_id + ' len=' + (typeof msg.content === 'string' ? msg.content.length : '?') + ' isSelf=' + (msg.is_self === true)) } catch (e) {}; emit('message', msg) }).catch((e) => console.error('upsert fail', e))
      break
    case 'conversation_list':
      if (Array.isArray(msg.list)) store.setConversations(msg.list)
      emit('conversations', msg.list)
      break
    case 'history_list':
      if (Array.isArray(msg.list) && msg.target_id) {
        store.setMessages(msg.target_id, msg.list)
        try { console.log('[BANDQQ] v17 history set target=' + msg.target_id + ' n=' + msg.list.length) } catch (e) {}
        emit('history', msg)
      } else {
        try { console.log('[BANDQQ] v17 history BAD target=' + msg.target_id + ' isArr=' + Array.isArray(msg.list)) } catch (e) {}
      }
      break
    case 'connect_state':
      store.setConnectState(msg)
      emit('state', msg)
      break
    case 'visible_contacts':
      if (Array.isArray(msg.contacts)) store.setVisibleContacts(msg.contacts)
      emit('visible_contacts', msg.contacts)
      break
    case 'quick_replies':
      if (Array.isArray(msg.list)) store.setQuickReplies(msg.list)
      emit('quick_replies', msg.list)
      break
    case 'clear_all_history':
      store.clearAllMessages().then(() => emit('cleared'))
      break
    case 'settings_state':
      // v2.8.0 双端互通：手机端设置快照落地 + 通知设置页刷新
      store.setSettings(msg).then(() => emit('settings', msg))
      break
    case 'direct_config':
      // v2.10.0 eSIM 独立线路：手机端连接时下发 NapCat HTTP 直连配置（url+token），
      // 手环持久化；eSIM 机型在互联断开（手机不在旁）时自动切直连收发
      store.setDirectCfg({ url: msg.url, token: msg.token }).then(() => emit('direct_config', msg))
      break
    case 'action_result':
      // v2.13.0 OneBot v11 扩展动作结果：点赞/拍一拍/群签到/撤回/表情回应的成败 toast；
      // message_id 回填帧（action=send）透传给 store 定位本地消息，供撤回/回应复用
      try {
        if (msg.action === 'send' && msg.message_id && msg.target_id) {
          store.bindMessageId(msg.target_id, msg.time, msg.message_id)
        }
        const pr = require('@system.prompt')
        pr.showToast({ msg: msg.info || (msg.ok ? '操作成功' : '操作失败'), duration: 1500 })
      } catch (e) {}
      emit('action_result', msg)
      break
    case 'user_info':
      // v2.13.0 资料查询结果：简版 toast 展示（昵称 + 群等级），完整帧 emit 给聊天页
      try {
        const pu = require('@system.prompt')
        pu.showToast({ msg: (msg.nickname || '未知用户') + (msg.level ? ' · Lv' + msg.level : ''), duration: 2000 })
      } catch (e) {}
      emit('user_info', msg)
      break
    case 'band_alert':
      // v2.8.0 自动拉起提示震动：快应用被后台自动打开时提醒用户（手动打开不触发）。
      // mode 1=短震×2（默认）2=长震；与 push_message 的单次短震区分。
      try {
        const vib = require('@system.vibrator')
        if (msg.mode === 2) {
          vib.vibrate({ mode: 'long' })
        } else {
          vib.vibrate({ mode: 'short' })
          setTimeout(() => { try { vib.vibrate({ mode: 'short' }) } catch (e) {} }, 260)
        }
      } catch (e) {}
      break
    default:
      break
  }
}

/**
 * v2.10.0 直连回退：互联失败/未连接且有直连配置（eSIM 机型）时，把协议帧
 * 翻译为 OneBot HTTP 调用直发 NapCat。无直连配置时保持原互联错误路径。
 */
function viaDirect(payload) {
  const cfg = store.getDirectCfg()
  if (!cfg) return Promise.reject({ code: 'NO_CHANNEL' })
  return direct.sendPayload(cfg, payload).then(
    (r) => { console.log('[BANDQQ] v21 direct OK') ; return r },
    (e) => { console.log('[BANDQQ] v21 direct FAIL', JSON.stringify(e)) ; throw e }
  )
}

/** 连接建立后的权威首拉（v2.10.0 起 onCreate 不再重复四连 send） */
function pullAll() {
  api.send(protocol.getConnectState())
  api.send(protocol.getVisibleContacts())
  api.send(protocol.getConversations())
  api.send(protocol.getSettings())
}

/**
 * 全局统一上行入口：由 app 层持有的 api 发送，不受页面销毁影响。
 * 返回 Promise，页面可链式观察成功/失败。
 * v2.10.0 通道编排：互联已连接 → 互联（失败回退直连）；未连接且有直连配置 →
 * 直连优先（省去互联 waitReady 最长 10s 的等待）；都无 → 原互联路径（错误可见）。
 */
function sendUpstream(payload) {
  console.log('[BANDQQ] v21 upstream ->', JSON.stringify(payload).slice(0, 160))
  if (api.isConnected()) {
    return api.send(payload).catch((e) => {
      console.log('[BANDQQ] v21 upstream FAIL -> direct fallback', JSON.stringify(e))
      return viaDirect(payload)
    })
  }
  const cfg = store.getDirectCfg()
  if (cfg) return viaDirect(payload)
  return api.send(payload)
}

export default {
  api,
  protocol,
  store,
  handleMessage,
  emit,
  sendUpstream,
  on(event, fn) {
    if (!listeners[event]) listeners[event] = []
    listeners[event].push(fn)
  },
  off(event, fn) {
    const set = listeners[event]
    if (!set) return
    if (!fn) {
      listeners[event] = []
      return
    }
    const idx = set.indexOf(fn)
    if (idx >= 0) set.splice(idx, 1)
  },
  onCreate() {
    console.log('[BANDQQ] v21 app onCreate, protocol=', typeof protocol, 'store=', typeof store, 'api=', typeof api, 'direct=', typeof direct)
    store.init()
    // v2.10.0 清理：原 onCreate 尾部四连 send 在连接未 open 时注定丢失（interconnect
    // 帧在 onopen 前不可投递），onOpen 里的 pullAll 才是有效首拉 —— 删除重复四连，
    // 省去四帧无效 send（含 10s waitReady 兑底计时的空转）
    api.init({
      onMessage: handleMessage,
      onOpen: () => {
        api.send({ type: 'band_state', state: 'connected', seq: 0 })
        pullAll()
      }
    })
  }
}


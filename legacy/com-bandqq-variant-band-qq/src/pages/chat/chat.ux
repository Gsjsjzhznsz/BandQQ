<import name="input-method" src="../../components/InputMethod/index.ux"></import>

<template>
  <div class="page">
    <!-- 顶栏 -->
    <div class="topbar">
      <text class="back" onclick="goBack">‹</text>
      <text class="title">{{name}}</text>
    </div>

    <!-- 加载更早 -->
    <text class="older-bar" onclick="loadOlder">{{olderText}}</text>

    <!-- 消息列表 -->
    <list class="msg-list" id="msgList">
      <list-item class="msg-item" for="{{(idx, m) in msgs}}" key="{{m.key}}">
        <text class="time-split" if="{{m.showTime}}">{{m.timeText}}</text>
        <div class="row {{m.isSelf ? 'row-self' : 'row-other'}}">
          <text class="sender" if="{{m.needName}}" style="color: {{m.senderColor}};">{{m.senderName}}</text>
          <text class="bubble {{m.isSelf ? 'bubble-self' : (m.isAtMe ? 'bubble-atme' : 'bubble-other')}}">{{m.content}}</text>
        </div>
      </list-item>
    </list>

    <!-- 快捷回复 -->
    <list class="quick-list" scrollpage="false">
      <list-item class="quick-item" for="{{(idx, q) in quicks}}" onclick="sendQuick(q)">
        <text class="quick-text">{{q.label}}</text>
      </list-item>
    </list>

    <!-- 草稿预览 -->
    <text class="draft">{{draftText || '　'}}</text>

    <!-- 输入法 -->
    <input-method onsend="onImSend" oninput="onImInput" onquick="onImQuick"></input-method>
  </div>
</template>

<style>
  .page { flex-direction: column; background-color: #101216; }
  .topbar {
    height: 28px; flex-direction: row; align-items: center;
    background-color: #181c23; padding: 0 8px; flex-shrink: 0;
  }
  .back { color: #9aa2af; font-size: 18px; margin-right: 8px; width: 18px; }
  .title { color: #eef1f6; font-size: 14px; lines: 1; text-overflow: ellipsis; flex: 1; }
  .older-bar {
    height: 22px; background-color: #161a21; color: #5865f2; font-size: 11px;
    text-align: center; flex-shrink: 0;
  }
  .msg-list { flex: 1; flex-direction: column; }
  .msg-item { flex-direction: column; justify-content: flex-start; }
  .time-split {
    color: #565b64; font-size: 10px; text-align: center;
    margin-top: 6px; margin-bottom: 4px;
  }
  .row { flex-direction: row; align-items: flex-start; padding: 0 8px; margin-top: 3px; }
  .row-other { justify-content: flex-start; }
  .row-self { justify-content: flex-end; }
  .sender { color: #6a707c; font-size: 9px; margin-right: 4px; margin-top: 5px; }
  .bubble {
    max-width: 150px; border-radius: 10px; padding: 5px 8px;
    font-size: 13px; lines: 4; text-overflow: ellipsis;
  }
  .bubble-other { background-color: #232830; color: #e8ebf0; }
  .bubble-self { background-color: #1e7f3f; color: #eafff0; }
  .bubble-atme { background-color: #232830; color: #ffd7bd; border: 1px solid #e8663c; }
  .quick-list { height: 24px; flex-direction: row; flex-shrink: 0; background-color: #14171d; }
  .quick-item {
    height: 24px; justify-content: center; align-items: center;
    padding: 0 8px; margin: 0 2px; background-color: #1e242e; border-radius: 4px;
  }
  .quick-text { color: #9fb6d9; font-size: 11px; }
  .draft {
    height: 16px; color: #cfd3da; font-size: 11px;
    lines: 1; text-overflow: ellipsis; margin: 1px 8px 0 8px; flex-shrink: 0;
  }
</style>

<script>
import * as store from '../../common/store.js'
import * as protocol from '../../common/protocol.js'

const QUICK_REPLIES = [
  { label: '收到', text: '收到' },
  { label: '好的', text: '好的' },
  { label: 'OK', text: 'OK' },
  { label: '谢谢', text: '谢谢' },
  { label: '稍等', text: '稍等' },
  { label: '在忙', text: '在忙，晚点回' },
  { label: '哈哈', text: '哈哈' },
  { label: '好的没问题', text: '好的，没问题' },
  { label: '晚上聊', text: '晚上聊' }
]

function nameColor(name) {
  let h = 0
  for (let i = 0; i < (name || '').length; i++) h = (h * 31 + name.charCodeAt(i)) >>> 0
  const colors = ['#7bc862', '#65aadd', '#e17076', '#a695e7', '#ee7aae', '#faa774']
  return colors[h % colors.length]
}

export default {
  data: {
    targetId: '',
    chatType: 'group',
    name: '',
    msgs: [],
    quicks: QUICK_REPLIES,
    draftText: '',
    olderText: '↓ 加载更早的消息',
    loadingOlder: false,
    olderEnd: false
  },
  onInit() {
    const params = this.$page ? this.$page.params : {}
    this.targetId = params.targetId || ''
    this.chatType = params.chatType || 'group'
    this.name = params.name || this.targetId
    this.$app.subscribe((push) => this.onPush(push))
  },
  onShow() {
    store.setActiveChat(this.targetId)
    // 首次拉取最近消息（本地有就直接渲染）
    this.renderMessages()
    if ((store.getMessages(this.targetId) || []).length < 15 && !this.recentAsked) {
      this.recentAsked = true
      this.$app.requestHistory(this.targetId, this.chatType, 20, {})
      this.recentGuard = setTimeout(() => {
        if (this.msgs.length === 0) this.olderText = '暂无更多消息'
      }, 6000)
    }
  },
  onHide() {
    if (this.recentGuard) { clearTimeout(this.recentGuard); this.recentGuard = null }
    if (this.olderGuard) { clearTimeout(this.olderGuard); this.olderGuard = null }
  },
  onPush(push) {
    if (push.type === 'message') {
      const m = push.data
      if (m.targetId !== this.targetId) return
      store.setActiveChat(this.targetId)
      this.renderMessages()
    } else if (push.type === 'history') {
      if (push.data.targetId !== this.targetId) return
      this.finishHistory(push.data.mode, push.data.messages)
    } else if (push.type === 'send_failed') {
      if (push.data.targetId !== this.targetId) return
      this.olderText = '发送失败，请检查连接'
      setTimeout(() => { this.olderText = '↓ 加载更早的消息' }, 2000)
    }
  },
  finishHistory(mode, messages) {
    if (mode === 'older') {
      this.loadingOlder = false
      if (this.olderGuard) { clearTimeout(this.olderGuard); this.olderGuard = null }
      if (!messages || messages.length === 0) {
        this.olderEnd = true
        this.olderText = '没有更早的消息了'
      } else {
        this.olderText = '↓ 加载更早的消息'
        this.renderMessages()
      }
    } else {
      if (this.recentGuard) { clearTimeout(this.recentGuard); this.recentGuard = null }
      this.renderMessages()
    }
  },
  renderMessages() {
    const raw = store.getMessages(this.targetId) || []
    const out = []
    let prevTime = 0
    for (let i = 0; i < raw.length; i++) {
      const m = raw[i]
      const t = m.time
      const showTime = protocol.needTimeSplit(prevTime, t)
      prevTime = t
      const isSelf = !!m.is_self
      out.push({
        key: (m.message_id || 0) + '-' + i + '-' + t,
        isSelf: isSelf,
        needName: !isSelf && this.chatType === 'group',
        senderName: m.sender_name || m.sender_id || '',
        content: m.content || '',
        timeText: protocol.formatTime(t),
        showTime: showTime,
        isAtMe: !!m.at_me && !isSelf,
        senderColor: nameColor(m.sender_name)
      })
    }
    this.msgs = out
    store.setActiveChat(this.targetId)
  },
  loadOlder() {
    if (this.loadingOlder || this.olderEnd) return
    const local = store.getMessages(this.targetId) || []
    const before = local.length ? local[0].time : Date.now()
    this.loadingOlder = true
    this.olderText = '加载中…'
    this.$app.requestHistory(this.targetId, this.chatType, 20, { older: true, beforeTime: before })
    // 6s 超时兜底（v1.1.0 翻页无响应问题的保护）
    this.olderGuard = setTimeout(() => {
      if (this.loadingOlder) {
        this.loadingOlder = false
        this.olderText = '加载失败，点按重试'
      }
    }, 6000)
  },
  sendQuick(q) {
    this.sendText(q.text)
  },
  onImSend(evt) {
    const text = (evt && evt.detail && evt.detail.text) || ''
    if (text) this.sendText(text)
  },
  onImInput(evt) {
    this.draftText = (evt && evt.detail && evt.detail.text) || ''
  },
  sendText(text) {
    // 乐观回显
    store.upsertMessage({
      messageId: 0,
      chatType: this.chatType,
      targetId: this.targetId,
      senderId: store.myProfile.userId,
      senderName: store.myProfile.nickname || '我',
      content: text,
      time: Date.now(),
      isSelf: true
    })
    this.renderMessages()
    this.draftText = ''
    this.$app.sendText(this.targetId, this.chatType, text)
  },
  goBack() {
    require('@system.router').back()
  }
}
</script>
